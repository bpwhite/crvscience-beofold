# /etc/beofold/node.env (chmod 0600, owned by root:root)
# Environment variables read by beofold-node.service on boot

# QUIC TLS 1.3 listen socket for home Beowulf LAN discovery & RPCs
BEOFOLD_BIND_ADDR=0.0.0.0:7443

# Shared secret authenticating all Windows & Linux PCs on this LAN cluster
BEOFOLD_CLUSTER_SECRET=change-me-home-beowulf-secret

# Human-readable host label shown in `fold-node cluster-status` and `fold-gui`
BEOFOLD_NODE_LABEL=linux-worker-01

# Optional public Apache Web Sync Server URL (leave empty "" for LAN-only operation).
# Only the elected LAN Raft Leader polls this URL over outbound HTTPS!
BEOFOLD_SYNC_URL=""

# Cluster name reported to the Apache Web Sync Server when federated
BEOFOLD_CLUSTER_NAME="Corvallis-Home-Beowulf"

# Optional extra CLI flags (e.g. "--auto-throttle --max-cpu 80 --init-trpcage" or "--no-gpu")
BEOFOLD_NODE_EXTRA_ARGS="--auto-throttle --max-cpu 85"
