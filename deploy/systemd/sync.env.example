# /etc/beofold/sync.env (chmod 0600, owned by root:root)
# Environment variables read by beofold-sync.service on boot

# Loopback address forwarded by Apache `ProxyPass "/beofold/api/v1/" "http://127.0.0.1:8780/beofold/api/v1/"`
BEOFOLD_SYNC_BIND=127.0.0.1:8780

# Cross-cluster verification quorum (`1` = trusted + deterministic canary checks; `2` = redundant dual-cluster quorum)
BEOFOLD_SYNC_QUORUM=1

# Optional extra CLI flags (e.g. "--init-trpcage" or "--strict-trust --trust-cluster <HEX_PUBKEY>")
BEOFOLD_SYNC_EXTRA_ARGS=""
